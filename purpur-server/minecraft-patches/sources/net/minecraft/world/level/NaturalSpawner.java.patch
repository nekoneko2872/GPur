+    private static List<Vec3> collectMobScanPlayers(ServerLevel level) {
+        List<Vec3> playerPositions = new ArrayList<>(level.players().size());
+
+        for (Player player : level.players()) {
+            if (!player.isAlive()) {
+                continue;
+            }
+            if (level.purpurConfig.mobSpawningIgnoreCreativePlayers && player.isCreative()) {
+                continue;
+            }
+
+            playerPositions.add(player.position());
+        }
+
+        return playerPositions;
+    }
