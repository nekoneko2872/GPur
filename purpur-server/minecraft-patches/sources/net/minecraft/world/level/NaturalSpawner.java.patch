+            randomWalk[0] += level.random.nextInt(6) - level.random.nextInt(6);
+            randomWalk[1] += level.random.nextInt(6) - level.random.nextInt(6);
+            candidateBlocks.add(new BlockPos(randomWalk[0], y, randomWalk[1]));
+            candidatePositions.add(new Vec3(randomWalk[0] + 0.5, y, randomWalk[1] + 0.5));
