+        private Priority getChunkTaskPriority(final int chunkX, final int chunkZ) {
+            final PreloadPriorityType priorityType = this.getPreloadPriorityType(chunkX, chunkZ);
+            if (priorityType == PreloadPriorityType.NONE) {
+                return Priority.NORMAL;
+            }
+
+            final int dx = chunkX - this.lastChunkX;
+            final int dz = chunkZ - this.lastChunkZ;
+            final int squareDistance = Math.max(Math.abs(dx), Math.abs(dz));
+            final int priorityBoundary = Math.max(this.lastLoadDistance + 2, this.preloadProfile.lookaheadChunks() / 2);
+
+            if (priorityType == PreloadPriorityType.CURRENT) {
+                return squareDistance >= priorityBoundary || GPurConfig.turboModeEnabled ? Priority.HIGHEST : Priority.HIGHER;
+            }
+
+            return GPurConfig.turboModeEnabled ? Priority.HIGHEST : Priority.HIGHER;
+        }
