+        private double applyRateMultiplier(final double baseRate, final double configuredMultiplier) {
+            if (baseRate >= (double)MAX_RATE || configuredMultiplier <= 1.0D) {
+                return baseRate;
+            }
+
+            final double boostFactor = this.getElytraThroughputBoostFactor();
+            if (boostFactor <= 0.0D) {
+                return baseRate;
+            }
+
+            final double effectiveMultiplier = 1.0D + ((configuredMultiplier - 1.0D) * boostFactor);
+            return Math.max(baseRate, Math.min((double)MAX_RATE, baseRate * effectiveMultiplier));
+        }
