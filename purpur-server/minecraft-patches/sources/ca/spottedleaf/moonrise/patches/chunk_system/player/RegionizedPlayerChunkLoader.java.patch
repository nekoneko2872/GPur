+        private RetainedPreloadWindow computeRetainedPreloadWindow(
+            final int currentChunkX,
+            final int currentChunkZ,
+            final PreloadProfile nextProfile,
+            final long nowNanos
+        ) {
+            if (!GPurConfig.preloadRetentionEnabled || GPurConfig.preloadRetentionMillis <= 0) {
+                return RetainedPreloadWindow.inactive();
+            }
+
+            RetainedPreloadWindow retained = this.retainedPreload.active(nowNanos) ? this.retainedPreload : RetainedPreloadWindow.inactive();
+
+            if (this.preloadProfile.active()) {
+                boolean shouldRetainPrevious = !nextProfile.active();
+                if (!shouldRetainPrevious && nextProfile.active()) {
+                    shouldRetainPrevious = this.directionDot(this.preloadProfile, nextProfile) < GPurConfig.preloadRetentionDirectionDotThreshold;
+                }
+
+                if (shouldRetainPrevious) {
+                    retained = new RetainedPreloadWindow(
+                        currentChunkX,
+                        currentChunkZ,
+                        this.preloadProfile,
+                        nowNanos + TimeUnit.MILLISECONDS.toNanos(GPurConfig.preloadRetentionMillis)
+                    );
+                }
+            }
+
+            if (!retained.active(nowNanos)) {
+                return RetainedPreloadWindow.inactive();
+            }
+
+            if (nextProfile.active() && this.directionDot(retained.profile(), nextProfile) >= GPurConfig.preloadRetentionDirectionDotThreshold) {
+                return RetainedPreloadWindow.inactive();
+            }
+
+            return retained;
+        }
