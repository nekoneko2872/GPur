+        private int calculateEffectiveLoadDistance(
+            final int loadViewDistance,
+            final PreloadProfile profile,
+            final RetainedPreloadWindow retained,
+            final SharedPreloadSelection sharedSelection,
+            final long nowNanos
+        ) {
+            int effectiveDistance = loadViewDistance + 1;
+            if (profile.active()) {
+                effectiveDistance = Math.max(effectiveDistance, profile.lookaheadChunks());
+            }
+            if (retained.active(nowNanos)) {
+                effectiveDistance = Math.max(effectiveDistance, retained.profile().lookaheadChunks());
+            }
+            for (final SharedPreloadAnchor anchor : sharedSelection.anchors()) {
+                effectiveDistance = Math.max(effectiveDistance, anchor.profile().lookaheadChunks());
+            }
+
+            if (GPurConfig.turboModeEnabled) {
+                effectiveDistance = Math.max(effectiveDistance, (loadViewDistance + 1) + GPurConfig.turboExtraLookahead);
+                if (profile.active()) {
+                    effectiveDistance = Math.max(effectiveDistance, profile.lookaheadChunks() + GPurConfig.turboExtraLookahead);
+                }
+                if (retained.active(nowNanos)) {
+                    effectiveDistance = Math.max(effectiveDistance, retained.profile().lookaheadChunks() + Math.max(1, GPurConfig.turboExtraLookahead / 2));
+                }
+                for (final SharedPreloadAnchor anchor : sharedSelection.anchors()) {
+                    effectiveDistance = Math.max(effectiveDistance, anchor.profile().lookaheadChunks() + Math.max(1, GPurConfig.turboExtraLookahead / 2));
