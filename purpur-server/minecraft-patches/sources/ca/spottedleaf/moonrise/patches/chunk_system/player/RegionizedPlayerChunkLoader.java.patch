+        private int compareByQueuePriority(final long c1, final long c2) {
+            final int c1Band = this.getQueuePriorityBand(c1);
+            final int c2Band = this.getQueuePriorityBand(c2);
+            final int bandComparison = Integer.compare(c1Band, c2Band);
+            if (bandComparison != 0) {
+                return bandComparison;
+            }
+
+            if (c1Band <= 1) {
+                final int forwardComparison = Double.compare(this.getForwardPriorityScore(c2), this.getForwardPriorityScore(c1));
+                if (forwardComparison != 0) {
+                    return forwardComparison;
+                }
+            }
+
+            return this.compareByManhattan(c1, c2);
+        }
+
+        private int compareByManhattan(final long c1, final long c2) {
+            final int c1x = CoordinateUtils.getChunkX(c1);
+            final int c1z = CoordinateUtils.getChunkZ(c1);
+            final int c2x = CoordinateUtils.getChunkX(c2);
+            final int c2z = CoordinateUtils.getChunkZ(c2);
+            final int centerX = this.lastChunkX;
+            final int centerZ = this.lastChunkZ;
+
+            return Integer.compare(
+                Math.abs(c1x - centerX) + Math.abs(c1z - centerZ),
+                Math.abs(c2x - centerX) + Math.abs(c2z - centerZ)
+            );
+        }
+
+        private int getQueuePriorityBand(final long chunkKey) {
+            final int chunkX = CoordinateUtils.getChunkX(chunkKey);
+            final int chunkZ = CoordinateUtils.getChunkZ(chunkKey);
+            final PreloadPriorityType priorityType = this.getPreloadPriorityType(chunkX, chunkZ);
+            if (priorityType == PreloadPriorityType.CURRENT) {
+                return 0;
+            }
+            if (priorityType == PreloadPriorityType.RETAINED || priorityType == PreloadPriorityType.SHARED) {
+                return 1;
+            }
+
+            final int dx = this.lastChunkX - chunkX;
+            final int dz = this.lastChunkZ - chunkZ;
+            return Math.max(Math.abs(dx), Math.abs(dz)) <= this.lastLoadDistance + 1 ? 2 : 3;
+        }
+
+        private double getForwardPriorityScore(final long chunkKey) {
+            final int chunkX = CoordinateUtils.getChunkX(chunkKey);
+            final int chunkZ = CoordinateUtils.getChunkZ(chunkKey);
+
+            double bestScore = Double.NEGATIVE_INFINITY;
+            if (this.preloadProfile.active()) {
+                bestScore = Math.max(bestScore, GPurElytraPreloadMath.forwardPriorityScore(
+                    this.preloadProfile,
+                    this.lastChunkX,
+                    this.lastChunkZ,
+                    chunkX,
+                    chunkZ
+                ));
+            }
+
+            final long nowNanos = System.nanoTime();
+            if (this.retainedPreload.active(nowNanos)) {
+                bestScore = Math.max(bestScore, GPurElytraPreloadMath.forwardPriorityScore(
+                    this.retainedPreload.profile(),
+                    this.retainedPreload.centerChunkX(),
+                    this.retainedPreload.centerChunkZ(),
+                    chunkX,
+                    chunkZ
+                ));
+            }
+
+            for (final SharedPreloadAnchor anchor : this.sharedPreloadSelection.anchors()) {
+                bestScore = Math.max(bestScore, GPurElytraPreloadMath.forwardPriorityScore(
+                    anchor.profile(),
+                    anchor.centerChunkX(),
+                    anchor.centerChunkZ(),
+                    chunkX,
+                    chunkZ
+                ));
+            }
+
+            return bestScore;
+        }
