+            final double fullRange = Math.max(0.1D, GPurConfig.elytraBoostFullSpeed - GPurConfig.elytraBoostStartSpeed);
+            return Math.min(1.0D, (speed - GPurConfig.elytraBoostStartSpeed) / fullRange);
+        }
