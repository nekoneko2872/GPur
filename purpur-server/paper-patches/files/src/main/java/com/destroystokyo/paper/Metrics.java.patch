        private static String currentGpuDeviceName() {
            try {
                final org.gpur.generation.GPurGenerationStatusSnapshot snapshot = org.gpur.GPurServices.generation().statusSnapshot();
                if (snapshot == null || snapshot.mode() == org.gpur.generation.GPurComputeMode.CPU || !snapshot.available()) {
                    return "None";
                }

                final String deviceName = snapshot.deviceName();
                if (deviceName == null || deviceName.isBlank()) {
                    return "None";
                }
                return deviceName;
            } catch (final Throwable throwable) {
                return "None";
            }
        }
