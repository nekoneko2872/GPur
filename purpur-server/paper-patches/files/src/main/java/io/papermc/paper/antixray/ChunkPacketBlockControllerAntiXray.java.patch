+        // HIDE mode is the closest fit for the current GPU path. Other Paper anti-xray
+        // modes can diverge from the exact CPU behavior, so keep them behind an explicit opt-in.
+        if (this.engineMode != EngineMode.HIDE && !GPurConfig.antiXrayGpuAllowInexactResults) {
+            return false;
+        }
+
+        try {
+            Map<Integer, GpurPreparedSection> preparedSections = this.prepareGpuSections(chunkPacketInfoAntiXray);
+            if (preparedSections.isEmpty()) {
+                return false;
+            }
+
+            List<GPurAntiXraySectionRequest> requestSections = new ArrayList<>(preparedSections.size());
+            for (GpurPreparedSection preparedSection : preparedSections.values()) {
+                requestSections.add(
+                    new GPurAntiXraySectionRequest(
+                        preparedSection.sectionIndex(),
+                        preparedSection.presetBlockStateBits(),
+                        preparedSection.stateFlags(),
+                        this.buildGpuPaddedTransparency(chunkPacketInfoAntiXray, preparedSections, preparedSection.sectionIndex())
+                    )
+                );
+            }
+
+            GPurAntiXrayBatchResult result = GPurServices.generation().submitAntiXrayBatch(
+                new GPurAntiXrayBatchRequest(
+                    chunkPacketInfoAntiXray.getChunk().getLevel().dimension().identifier().toString(),
+                    chunkPacketInfoAntiXray.getChunk().getPos().x,
+                    chunkPacketInfoAntiXray.getChunk().getPos().z,
+                    requestSections
+                )
+            );
+            if (result == null) {
+                return false;
+            }
+
+            return this.applyGpuResult(chunkPacketInfoAntiXray, requestSections, result);
+        } catch (Throwable ignored) {
+            return false;
+        }
+    }
