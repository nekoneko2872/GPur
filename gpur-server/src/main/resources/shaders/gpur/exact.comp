#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Input { uint data[]; };
layout(std430, binding = 1) writeonly buffer Output { uint result[]; };

double readDouble(uint offset) { return packDouble2x32(uvec2(data[offset], data[offset + 1])); }

precise double preciseLerp(double alpha, double p0, double p1) {
    precise double difference = p1 - p0;
    precise double scaled = alpha * difference;
    precise double resultValue = p0 + scaled;
    return resultValue;
}

double interpolationCorner(uint interpolator, uint slice, uint z, uint y, uint zBoundaries, uint yBoundaries) {
    uint doubleIndex = ((interpolator * 2u + slice) * zBoundaries + z) * yBoundaries + y;
    return readDouble(6u + doubleIndex * 2u);
}

const int Q10 = 1024;

uint terrainHash(int x, int y, int z, uint seedLow, uint seedHigh, int salt) {
    uint h = uint(x) * 0x9e3779b9u;
    h ^= uint(y) * 0x85ebca6bu;
    h ^= uint(z) * 0xc2b2ae35u;
    h ^= seedLow;
    h ^= (seedHigh << 16u) | (seedHigh >> 16u);
    h ^= uint(salt) * 0x27d4eb2du;
    h ^= h >> 16u;
    h *= 0x7feb352du;
    h ^= h >> 15u;
    h *= 0x846ca68bu;
    h ^= h >> 16u;
    return h;
}

int terrainValue(int x, int y, int z, uint seedLow, uint seedHigh, int salt) {
    return int(terrainHash(x, y, z, seedLow, seedHigh, salt) & 2047u) - Q10;
}

int divideTowardZero(int value, int positiveDivisor) {
    // All numerators in terrain interpolation are bounded away from INT_MIN.
    // Divide only nonnegative operands, then restore the sign explicitly.
    return value < 0 ? -((-value) / positiveDivisor) : value / positiveDivisor;
}
int mulQ10(int a, int b) { return divideTowardZero(a * b, Q10); }
int lerpQ10(int a, int b, int t) { return a + divideTowardZero((b - a) * t, Q10); }
int smoothQ10(int fraction, int scale) {
    int t = divideTowardZero(fraction * Q10, scale);
    return mulQ10(mulQ10(t, t), 3 * Q10 - 2 * t);
}
int amplitude(int q10, int amount) { return divideTowardZero(q10 * amount, Q10); }
int clampInt(int v, int lo, int hi) { return max(lo, min(v, hi)); }
int signedWord(uint v) {
    // Convert modulo 2^32 without relying on out-of-range uint-to-int casts.
    return v <= 0x7fffffffu ? int(v) : -1 - int(~v);
}
int floorCell(int coordinate, int scale) {
    int magnitude = coordinate < 0 ? -coordinate : coordinate;
    int quotient = magnitude / scale;
    int remainder = magnitude % scale;
    return coordinate < 0 ? -quotient - (remainder == 0 ? 0 : 1) : quotient;
}
int floorFraction(int coordinate, int scale) {
    int magnitude = coordinate < 0 ? -coordinate : coordinate;
    int remainder = magnitude % scale;
    return coordinate < 0 && remainder != 0 ? scale - remainder : remainder;
}

int terrainNoise2(uint seedLow, uint seedHigh, int x, int z, int scale, int salt) {
    int gx = floorCell(x, scale);
    int gz = floorCell(z, scale);
    int fx = floorFraction(x, scale);
    int fz = floorFraction(z, scale);
    int sx = smoothQ10(fx, scale);
    int sz = smoothQ10(fz, scale);
    int a = lerpQ10(terrainValue(gx, 0, gz, seedLow, seedHigh, salt), terrainValue(gx + 1, 0, gz, seedLow, seedHigh, salt), sx);
    int b = lerpQ10(terrainValue(gx, 0, gz + 1, seedLow, seedHigh, salt), terrainValue(gx + 1, 0, gz + 1, seedLow, seedHigh, salt), sx);
    return lerpQ10(a, b, sz);
}

int terrainNoise3(uint seedLow, uint seedHigh, int x, int y, int z, int scale, int salt) {
    int gx = floorCell(x, scale);
    int gy = floorCell(y, scale);
    int gz = floorCell(z, scale);
    int fx = floorFraction(x, scale);
    int fy = floorFraction(y, scale);
    int fz = floorFraction(z, scale);
    int sx = smoothQ10(fx, scale);
    int sy = smoothQ10(fy, scale);
    int sz = smoothQ10(fz, scale);
    int z00 = lerpQ10(terrainValue(gx, gy, gz, seedLow, seedHigh, salt), terrainValue(gx + 1, gy, gz, seedLow, seedHigh, salt), sx);
    int z10 = lerpQ10(terrainValue(gx, gy + 1, gz, seedLow, seedHigh, salt), terrainValue(gx + 1, gy + 1, gz, seedLow, seedHigh, salt), sx);
    int z01 = lerpQ10(terrainValue(gx, gy, gz + 1, seedLow, seedHigh, salt), terrainValue(gx + 1, gy, gz + 1, seedLow, seedHigh, salt), sx);
    int z11 = lerpQ10(terrainValue(gx, gy + 1, gz + 1, seedLow, seedHigh, salt), terrainValue(gx + 1, gy + 1, gz + 1, seedLow, seedHigh, salt), sx);
    return lerpQ10(lerpQ10(z00, z10, sy), lerpQ10(z01, z11, sy), sz);
}

int terrainSurface(uint seedLow, uint seedHigh, int x, int z, int minY, int height, int seaLevel) {
    int continental = terrainNoise2(seedLow, seedHigh, x, z, 768, 11);
    int hills = terrainNoise2(seedLow, seedHigh, x, z, 192, 23);
    int detail = terrainNoise2(seedLow, seedHigh, x, z, 48, 37);
    int mountain = max(0, continental - 320);
    int natural = seaLevel + 2 + amplitude(continental, 42) + amplitude(hills, 24)
        + amplitude(detail, 6) + amplitude(mountain, 90);
    return clampInt(natural, minY + 8, minY + height - 1);
}

int terrainBiome(uint seedLow, uint seedHigh, int x, int z, int seaLevel, int surface) {
    if (surface < seaLevel) return 5; // ocean
    int continental = terrainNoise2(seedLow, seedHigh, x, z, 768, 11);
    int temperature = terrainNoise2(seedLow, seedHigh, x, z, 896, 301);
    int moisture = terrainNoise2(seedLow, seedHigh, x, z, 640, 302);
    if (surface >= seaLevel + 66 || (surface >= seaLevel + 38 && continental > 500)) return 7; // stony peaks
    if (temperature < -430) return 4; // snowy plains
    if (temperature > 390 && moisture < 120) return 2; // desert
    if (temperature < -145) return 3; // taiga
    if (surface > seaLevel + 28 && moisture > -180 && moisture < 260) return 6; // meadow
    if (moisture > 145) return 1; // forest
    return 0; // plains
}

uint terrainBlock(uint seedLow, uint seedHigh, int x, int y, int z, int minY, int seaLevel, int surface, int biome) {
    if (y == minY) return 3u; // bedrock
    if (y > surface) {
        if (y <= seaLevel) {
            if (y == seaLevel && biome == 4 && seaLevel - surface <= 8) return 12u; // ice
            return 4u; // water
        }
        return 0u; // air
    }
    if (y < surface - 4 && y > minY + 4
        && terrainNoise3(seedLow, seedHigh, x, y, z, 48, 501) > 535
        && terrainNoise3(seedLow, seedHigh, x, y, z, 22, 502) > -160) {
        return y < minY + 12 ? 5u : 0u; // fixed-depth cave lava
    }
    if (biome == 2) {
        if (y >= surface - 3) return 8u; // sand
        if (y >= surface - 7) return 9u; // sandstone
    } else if (biome == 5) {
        if (surface < seaLevel - 20) {
            if (y >= surface - 2) return 10u; // gravel
        } else if (y >= surface - 1) {
            return 8u; // sand
        }
    } else if (y == surface) {
        if (biome == 4) return 11u; // snow
        return biome == 7 ? 1u : 7u; // stone on peaks, grass elsewhere
    } else if (y >= surface - 3) {
        return biome == 7 ? 1u : 6u; // stone on peaks, dirt elsewhere
    }
    return y < seaLevel - 36 ? 2u : 1u; // deepslate or stone
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= data[1]) return;
    if (data[0] == 1u) {
        uint offset = 8u + i * 6u;
        precise double dx = readDouble(2u) - readDouble(offset);
        precise double dy = readDouble(4u) - readDouble(offset + 2u);
        precise double dz = readDouble(6u) - readDouble(offset + 4u);
        // Keep Java's operation order and prohibit contraction into FMA.
        precise double xx = dx * dx;
        precise double yy = dy * dy;
        precise double zz = dz * dz;
        precise double sumXY = xx + yy;
        precise double distance = sumXY + zz;
        uvec2 bits = unpackDouble2x32(distance);
        result[2u * i] = bits.x;
        result[2u * i + 1u] = bits.y;
    } else if (data[0] == 2u) {
        // A section has a complete 18^3 halo; one invocation owns one result word.
        uint section = i / 4096u;
        uint block = i % 4096u;
        uint offset = 2u + section * (4096u + 5832u);
        uint x = (block & 15u) + 1u;
        uint z = ((block >> 4u) & 15u) + 1u;
        uint y = (block >> 8u) + 1u;
        uint center = offset + 4096u + y * 324u + z * 18u + x;
        bool hidden = (data[offset + block] & 3u) == 3u;
        hidden = hidden && data[center - 1u] == 0u && data[center + 1u] == 0u;
        hidden = hidden && data[center - 18u] == 0u && data[center + 18u] == 0u;
        hidden = hidden && data[center - 324u] == 0u && data[center + 324u] == 0u;
        result[i] = hidden ? 1u : 0u;
    } else if (data[0] == 4u) {
        // The CPU has already evaluated the vanilla DensityFunction graph at
        // both X boundaries. One invocation computes one exact interpolation
        // result; mode 0 follows updateForY/X/Z and mode 1 follows Mth.lerp3.
        uint cellWidth = data[2];
        uint cellHeight = data[3];
        uint cellCountY = data[4];
        uint interpolatorCount = data[5];
        uint totalHeight = cellHeight * cellCountY;
        uint cellCountZ = 16u / cellWidth;

        uint zAcross16 = i % 16u;
        uint remainder = i / 16u;
        uint localX = remainder % cellWidth;
        remainder /= cellWidth;
        uint yAscending = remainder % totalHeight;
        remainder /= totalHeight;
        uint mode = remainder % 2u;
        uint interpolator = remainder / 2u;
        if (interpolator >= interpolatorCount) return;

        uint cellY = yAscending / cellHeight;
        uint localY = yAscending % cellHeight;
        uint cellZ = zAcross16 / cellWidth;
        uint localZ = zAcross16 % cellWidth;
        precise double alphaX = double(localX) / double(cellWidth);
        precise double alphaY = double(localY) / double(cellHeight);
        precise double alphaZ = double(localZ) / double(cellWidth);
        uint zBoundaries = cellCountZ + 1u;
        uint yBoundaries = cellCountY + 1u;

        double n000 = interpolationCorner(interpolator, 0u, cellZ, cellY, zBoundaries, yBoundaries);
        double n100 = interpolationCorner(interpolator, 1u, cellZ, cellY, zBoundaries, yBoundaries);
        double n010 = interpolationCorner(interpolator, 0u, cellZ, cellY + 1u, zBoundaries, yBoundaries);
        double n110 = interpolationCorner(interpolator, 1u, cellZ, cellY + 1u, zBoundaries, yBoundaries);
        double n001 = interpolationCorner(interpolator, 0u, cellZ + 1u, cellY, zBoundaries, yBoundaries);
        double n101 = interpolationCorner(interpolator, 1u, cellZ + 1u, cellY, zBoundaries, yBoundaries);
        double n011 = interpolationCorner(interpolator, 0u, cellZ + 1u, cellY + 1u, zBoundaries, yBoundaries);
        double n111 = interpolationCorner(interpolator, 1u, cellZ + 1u, cellY + 1u, zBoundaries, yBoundaries);
        precise double interpolated;
        if (mode == 0u) {
            // NoiseInterpolator.updateForY -> updateForX -> updateForZ.
            precise double valueXZ00 = preciseLerp(alphaY, n000, n010);
            precise double valueXZ10 = preciseLerp(alphaY, n100, n110);
            precise double valueXZ01 = preciseLerp(alphaY, n001, n011);
            precise double valueXZ11 = preciseLerp(alphaY, n101, n111);
            precise double valueZ0 = preciseLerp(alphaX, valueXZ00, valueXZ10);
            precise double valueZ1 = preciseLerp(alphaX, valueXZ01, valueXZ11);
            interpolated = preciseLerp(alphaZ, valueZ0, valueZ1);
        } else {
            // Mth.lerp3 is lerp(Z, lerp2(X,Y, first 4), lerp2(X,Y, last 4)).
            precise double x000 = preciseLerp(alphaX, n000, n100);
            precise double x010 = preciseLerp(alphaX, n010, n110);
            precise double x001 = preciseLerp(alphaX, n001, n101);
            precise double x011 = preciseLerp(alphaX, n011, n111);
            precise double y00 = preciseLerp(alphaY, x000, x010);
            precise double y01 = preciseLerp(alphaY, x001, x011);
            interpolated = preciseLerp(alphaZ, y00, y01);
        }
        uvec2 bits = unpackDouble2x32(interpolated);
        result[2u * i] = bits.x;
        result[2u * i + 1u] = bits.y;
    } else if (data[0] == 3u) {
        // One invocation owns one (chunk, localX, localZ) column. The CPU rules
        // use the same Q10 interpolation, unsigned hash and loop ordering.
        int minY = signedWord(data[4]);
        int height = signedWord(data[5]);
        int seaLevel = signedWord(data[7]);
        uint seedLow = data[2];
        uint seedHigh = data[3];
        uint chunk = i / 256u;
        uint column = i % 256u;
        int chunkX = signedWord(data[8u + chunk * 2u]);
        int chunkZ = signedWord(data[9u + chunk * 2u]);
        int localX = int(column & 15u);
        int localZ = int(column >> 4u);
        int x = chunkX * 16 + localX;
        int z = chunkZ * 16 + localZ;
        int surface = terrainSurface(seedLow, seedHigh, x, z, minY, height, seaLevel);
        int biome = terrainBiome(seedLow, seedHigh, x, z, seaLevel, surface);
        // Palette output layout is ((chunk * height) + yOffset) * 256 + column.
        for (int dy = 0; dy < height; dy++) {
            int y = minY + dy;
            uint outIndex = ((chunk * uint(height) + uint(dy)) * 256u) + uint(localZ * 16 + localX);
            result[outIndex] = terrainBlock(seedLow, seedHigh, x, y, z, minY, seaLevel, surface, biome);
        }
    }
}
