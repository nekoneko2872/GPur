#version 450

layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Input { uint data[]; };
layout(std430, binding = 1) writeonly buffer Output { uint result[]; };

// GPUR_AQUIFER_HELPERS

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (data[0] != 6u || i >= data[1]) return;
    uvec4 indices = rankVanillaAquifer(i);
    result[i * 4u] = indices.x;
    result[i * 4u + 1u] = indices.y;
    result[i * 4u + 2u] = indices.z;
    result[i * 4u + 3u] = indices.w;
}
