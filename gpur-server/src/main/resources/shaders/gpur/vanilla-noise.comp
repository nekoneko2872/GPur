#version 450
#extension GL_ARB_gpu_shader_fp64 : require

layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Input { uint data[]; };
layout(std430, binding = 1) writeonly buffer Output { uint result[]; };

double readDouble(uint offset) { return packDouble2x32(uvec2(data[offset], data[offset + 1u])); }
precise double preciseLerp(double alpha, double p0, double p1) {
    precise double difference = p1 - p0;
    precise double scaled = alpha * difference;
    precise double value = p0 + scaled;
    return value;
}

// GPUR_NOISE_HELPERS

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (data[0] != 5u || i >= data[1]) return;
    uint sampleOffset = data[4] + i * 11u;
    precise double value = evaluateVanillaNoise(data[sampleOffset], readDouble(sampleOffset + 1u),
        readDouble(sampleOffset + 3u), readDouble(sampleOffset + 5u), readDouble(sampleOffset + 7u), readDouble(sampleOffset + 9u));
    uvec2 bits = unpackDouble2x32(value);
    result[i * 2u] = bits.x;
    result[i * 2u + 1u] = bits.y;
}
