+    private static final class GpurAquiferRankingLease {
+        private final java.util.concurrent.atomic.AtomicReference<org.gpur.compute.WorldgenResult> pending =
+            new java.util.concurrent.atomic.AtomicReference<>();
+        private final java.util.concurrent.atomic.AtomicBoolean released = new java.util.concurrent.atomic.AtomicBoolean();
+
+        private CompletableFuture<org.gpur.compute.WorldgenResult> track(
+            CompletableFuture<org.gpur.compute.WorldgenResult> future
+        ) {
+            return future.handle((result, failure) -> {
+                if (failure != null) {
+                    if (result != null) result.close();
+                    return null;
+                }
+                if (result != null) {
+                    if (this.released.get()) {
+                        result.close();
+                    } else {
+                        this.pending.set(result);
+                        if (this.released.get() && this.pending.compareAndSet(result, null)) result.close();
+                    }
+                }
+                return result;
+            });
+        }
+
+        private void install(final Aquifer aquifer) {
+            org.gpur.compute.WorldgenResult result = this.pending.getAndSet(null);
+            if (result == null) return;
+            try {
+                aquifer.gpurInstallRanking(result);
+            } catch (RuntimeException | Error failure) {
+                result.close();
+                throw failure;
+            }
+        }
+
+        private void close(final @Nullable Aquifer aquifer) {
+            this.released.set(true);
+            org.gpur.compute.WorldgenResult result = this.pending.getAndSet(null);
+            if (result != null) result.close();
+            if (aquifer != null) aquifer.gpurClearRanking();
+        }
+    }
