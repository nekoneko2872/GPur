+    private static final class GpurStaticNoiseLease {
+        private final java.util.concurrent.atomic.AtomicReference<org.gpur.terrain.VanillaNoiseCache> pending =
+            new java.util.concurrent.atomic.AtomicReference<>();
+        private final java.util.concurrent.atomic.AtomicBoolean released = new java.util.concurrent.atomic.AtomicBoolean();
+
+        private CompletableFuture<org.gpur.terrain.VanillaNoiseCache> track(
+            CompletableFuture<org.gpur.terrain.VanillaNoiseCache> future
+        ) {
+            return future.handle((cache, failure) -> {
+                if (failure != null) {
+                    if (cache != null) cache.close();
+                    return null;
+                }
+                if (cache != null) {
+                    if (this.released.get()) {
+                        cache.close();
+                    } else {
+                        this.pending.set(cache);
+                        if (this.released.get() && this.pending.compareAndSet(cache, null)) cache.close();
+                    }
+                }
+                return cache;
+            });
+        }
+
+        private void install(final NoiseChunk noiseChunk) {
+            org.gpur.terrain.VanillaNoiseCache cache = this.pending.getAndSet(null);
+            if (cache == null) return;
+            try {
+                noiseChunk.gpurInstallStaticNoise(cache);
+            } catch (RuntimeException | Error failure) {
+                cache.close();
+                throw failure;
+            }
+        }
+
+        private void close() {
+            this.released.set(true);
+            org.gpur.terrain.VanillaNoiseCache cache = this.pending.getAndSet(null);
+            if (cache != null) cache.close();
+        }
+    }
+
+    private static final class GpurNoiseChunkCleanup {
+        private final Set<LevelChunkSection> sections;
+        private final GpurAquiferRankingLease ranking;
+        private final GpurStaticNoiseLease staticNoise;
+        private final java.util.concurrent.atomic.AtomicBoolean released = new java.util.concurrent.atomic.AtomicBoolean();
+        private volatile NoiseChunk noiseChunk;
+        private volatile Aquifer aquifer;
+
+        private GpurNoiseChunkCleanup(
+            Set<LevelChunkSection> sections, GpurAquiferRankingLease ranking, GpurStaticNoiseLease staticNoise
+        ) {
+            this.sections = sections;
+            this.ranking = ranking;
+            this.staticNoise = staticNoise;
+        }
+
+        private void noiseChunk(NoiseChunk noiseChunk) { this.noiseChunk = noiseChunk; }
+        private void aquifer(Aquifer aquifer) { this.aquifer = aquifer; }
+
+        private void close() {
+            if (!this.released.compareAndSet(false, true)) return;
+            NoiseChunk noiseChunk = this.noiseChunk;
+            if (noiseChunk != null) noiseChunk.gpurAbortInterpolation();
+            this.staticNoise.close();
+            this.ranking.close(this.aquifer);
+            for (LevelChunkSection section : this.sections) section.release();
+        }
     }
 
