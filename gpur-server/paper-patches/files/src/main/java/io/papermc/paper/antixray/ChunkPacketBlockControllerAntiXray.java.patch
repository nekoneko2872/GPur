+    private Map<Integer, GpurPreparedSection> prepareGpuSections(ChunkPacketInfoAntiXray chunkPacketInfoAntiXray) {
+        Map<Integer, GpurPreparedSection> sections = new LinkedHashMap<>();
+        BitStorageReader bitStorageReader = new BitStorageReader();
+        bitStorageReader.setBuffer(chunkPacketInfoAntiXray.getBuffer());
+        boolean[] solid = SOLID.get();
+        boolean[] obfuscate = OBFUSCATE.get();
+        LevelChunk chunk = chunkPacketInfoAntiXray.getChunk();
+        int maxChunkSectionIndex = Math.min((maxBlockHeight >> 4) - chunk.getMinSectionY(), chunk.getSectionsCount()) - 1;
+
+        for (int chunkSectionIndex = 0; chunkSectionIndex <= maxChunkSectionIndex; chunkSectionIndex++) {
+            if (!chunkPacketInfoAntiXray.isWritten(chunkSectionIndex) || chunkPacketInfoAntiXray.getPresetValues(chunkSectionIndex) == null) {
+                continue;
+            }
+
+            int[] presetBlockStateBits = this.resolvePresetBlockStateBits(chunkPacketInfoAntiXray, chunk, chunkSectionIndex);
+            bitStorageReader.setBits(chunkPacketInfoAntiXray.getBits(chunkSectionIndex));
+            bitStorageReader.setIndex(chunkPacketInfoAntiXray.getIndex(chunkSectionIndex));
+
+            boolean[] solidTemp = readPalette(chunkPacketInfoAntiXray.getPalette(chunkSectionIndex), solid, solidGlobal);
+            boolean[] obfuscateTemp = readPalette(chunkPacketInfoAntiXray.getPalette(chunkSectionIndex), obfuscate, obfuscateGlobal);
+            byte[] stateFlags = new byte[GPUR_SECTION_VOLUME];
+
+            for (int y = 0; y < 16; y++) {
+                for (int z = 0; z < 16; z++) {
+                    for (int x = 0; x < 16; x++) {
+                        int bits = bitStorageReader.read();
+                        byte flags = 0;
+                        if (solidTemp[bits]) {
+                            flags |= GPUR_SOLID_FLAG;
+                        }
+                        if (obfuscateTemp[bits]) {
+                            flags |= GPUR_OBFUSCATE_FLAG;
+                        }
+                        // Paper supports custom hidden non-conductors; retain its exact CPU path for those.
+                        if ((flags & GPUR_OBFUSCATE_FLAG) != 0 && (flags & GPUR_SOLID_FLAG) == 0) return Map.of();
+                        stateFlags[gpurBlockIndex(x, y, z)] = flags;
+                    }
+                }
+            }
+
+            sections.put(chunkSectionIndex, new GpurPreparedSection(chunkSectionIndex, presetBlockStateBits, stateFlags));
+        }
+
+        return sections;
+    }
+
+    private int[] resolvePresetBlockStateBits(ChunkPacketInfoAntiXray chunkPacketInfoAntiXray, LevelChunk chunk, int chunkSectionIndex) {
+        if (chunkPacketInfoAntiXray.getPalette(chunkSectionIndex) instanceof GlobalPalette) {
+            if (engineMode == EngineMode.HIDE) {
+                return switch (chunk.getLevel().getWorld().getEnvironment()) {
+                    case NETHER -> presetBlockStateBitsNetherrackGlobal;
+                    case THE_END -> presetBlockStateBitsEndStoneGlobal;
+                    default -> chunkSectionIndex + chunk.getMinSectionY() < 0 ? presetBlockStateBitsDeepslateGlobal : presetBlockStateBitsStoneGlobal;
+                };
+            }
+
+            return presetBlockStateBitsGlobal;
+        }
+
+        BlockState[] presetBlockStatesFull = chunkPacketInfoAntiXray.getPresetValues(chunkSectionIndex) == presetBlockStates
+            ? this.presetBlockStatesFull
+            : chunkPacketInfoAntiXray.getPresetValues(chunkSectionIndex);
+        int[] resolvedBits = new int[presetBlockStatesFull.length];
+
+        for (int i = 0; i < resolvedBits.length; i++) {
+            resolvedBits[i] = chunkPacketInfoAntiXray.getPalette(chunkSectionIndex).idFor(presetBlockStatesFull[i], PaletteResize.noResizeExpected());
+        }
+
+        return resolvedBits;
+    }
