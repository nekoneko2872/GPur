+        LevelChunk chunk = chunkPacketInfoAntiXray.getChunk();
+        GpurPreparedSection belowPrepared = preparedSections.get(chunkSectionIndex - 1);
+        GpurPreparedSection abovePrepared = preparedSections.get(chunkSectionIndex + 1);
+        LevelChunkSection belowChunkSection = chunkSectionIndex > 0 ? chunk.getSections()[chunkSectionIndex - 1] : EMPTY_SECTION;
+        LevelChunkSection aboveChunkSection = chunkSectionIndex + 1 < chunk.getSectionsCount() ? chunk.getSections()[chunkSectionIndex + 1] : EMPTY_SECTION;
+        LevelChunk[] nearbyChunks = chunkPacketInfoAntiXray.getNearbyChunks();
+        LevelChunkSection westChunkSection = nearbyChunks[0] == null ? EMPTY_SECTION : nearbyChunks[0].getSections()[chunkSectionIndex];
+        LevelChunkSection eastChunkSection = nearbyChunks[1] == null ? EMPTY_SECTION : nearbyChunks[1].getSections()[chunkSectionIndex];
+        LevelChunkSection northChunkSection = nearbyChunks[2] == null ? EMPTY_SECTION : nearbyChunks[2].getSections()[chunkSectionIndex];
+        LevelChunkSection southChunkSection = nearbyChunks[3] == null ? EMPTY_SECTION : nearbyChunks[3].getSections()[chunkSectionIndex];
+
+        for (int y = 0; y < 16; y++) {
+            for (int z = 0; z < 16; z++) {
+                for (int x = 0; x < 16; x++) {
+                    paddedTransparency[gpurPaddedIndex(x + 1, y + 1, z + 1)] = this.gpurTransparentByte(currentSection, x, y, z);
+                }
+            }
+        }
+
+        for (int z = 0; z < 16; z++) {
+            for (int x = 0; x < 16; x++) {
+                paddedTransparency[gpurPaddedIndex(x + 1, 0, z + 1)] = this.gpurTransparentByte(belowPrepared, x, 15, z, belowChunkSection);
+                paddedTransparency[gpurPaddedIndex(x + 1, 17, z + 1)] = this.gpurTransparentByte(abovePrepared, x, 0, z, aboveChunkSection);
+            }
+        }
+
+        for (int y = 0; y < 16; y++) {
+            for (int z = 0; z < 16; z++) {
+                paddedTransparency[gpurPaddedIndex(0, y + 1, z + 1)] = this.gpurTransparentByte(westChunkSection, 15, y, z);
+                paddedTransparency[gpurPaddedIndex(17, y + 1, z + 1)] = this.gpurTransparentByte(eastChunkSection, 0, y, z);
+            }
+        }
+
+        for (int y = 0; y < 16; y++) {
+            for (int x = 0; x < 16; x++) {
+                paddedTransparency[gpurPaddedIndex(x + 1, y + 1, 0)] = this.gpurTransparentByte(northChunkSection, x, y, 15);
+                paddedTransparency[gpurPaddedIndex(x + 1, y + 1, 17)] = this.gpurTransparentByte(southChunkSection, x, y, 0);
+            }
+        }
+
+        return paddedTransparency;
+    }
