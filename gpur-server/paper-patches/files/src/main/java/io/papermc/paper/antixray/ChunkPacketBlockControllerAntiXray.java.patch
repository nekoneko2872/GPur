+    private boolean gpurObfuscate(ChunkPacketInfoAntiXray info) {
+        ComputeService service = GPurServices.compute();
+        if (!GPurConfig.antiXrayGpuEnabled || this.engineMode != EngineMode.HIDE || service == null || !service.eligible(2)) return false;
+        LevelChunk chunk = info.getChunk();
+        int max = Math.min((this.maxBlockHeight >> 4) - chunk.getMinSectionY(), chunk.getSectionsCount()) - 1;
+        int count = 0;
+        for (int i = 0; i <= max; i++) if (info.isWritten(i) && info.getPresetValues(i) != null) count++;
+        // Gate before decoding the packet or allocating halo buffers.
+        if (count < GPurConfig.antiXrayGpuMinSections) return false;
+        byte[] original = info.getBuffer();
+        try {
+            Map<Integer, GpurPreparedSection> sections = this.prepareGpuSections(info);
+            if (sections.size() != count) return false;
+            int[] input = new int[2 + count * ExactCompute.SECTION_WORDS];
+            input[0] = 2;
+            input[1] = count * GPUR_SECTION_VOLUME;
+            int offset = 2;
+            for (GpurPreparedSection section : sections.values()) {
+                if (section.presetBlockStateBits().length != 1) return false;
+                for (byte flag : section.stateFlags()) input[offset++] = flag;
+                for (byte transparent : this.buildGpuPaddedTransparency(info, sections, section.sectionIndex())) input[offset++] = transparent;
+            }
+            int[] mask = service.tryCompute(input);
+            if (mask == null || mask.length != count * GPUR_SECTION_VOLUME) return false;
+            for (int value : mask) if (value != 0 && value != 1) return false;
+            // Stage the entire packet. A failure must never leave a partially obfuscated buffer.
+            byte[] staged = original.clone();
+            BitStorageWriter writer = new BitStorageWriter();
+            writer.setBuffer(staged);
+            offset = 0;
+            for (GpurPreparedSection section : sections.values()) {
+                writer.setBits(info.getBits(section.sectionIndex()));
+                writer.setIndex(info.getIndex(section.sectionIndex()));
+                for (int block = 0; block < GPUR_SECTION_VOLUME; block++) {
+                    if (mask[offset++] == 1) writer.write(section.presetBlockStateBits()[0]);
+                    else writer.skip();
+                }
+                writer.flush();
+            }
+            // Validate byte-for-byte against Paper itself, including section and height boundaries.
+            long packet = this.gpurPackets.incrementAndGet();
+            if (packet == 1 || packet % 256 == 0) {
+                byte[] reference = original.clone();
+                info.setBuffer(reference);
+                try { this.obfuscateCpu(info); } finally { info.setBuffer(original); }
+                if (!java.util.Arrays.equals(reference, staged)) {
+                    service.rejectAntiXray();
+                    System.arraycopy(reference, 0, original, 0, original.length);
+                    return true;
+                }
+            }
+            System.arraycopy(staged, 0, original, 0, original.length);
+            return true;
+        } catch (RuntimeException failure) {
+            info.setBuffer(original);
+            service.rejectAntiXray();
+            return false;
+        }
+    }
