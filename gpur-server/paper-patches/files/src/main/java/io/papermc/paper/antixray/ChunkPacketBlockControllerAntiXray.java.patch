+    private byte gpurTransparentByte(GpurPreparedSection section, int x, int y, int z) {
+        return (byte)(section == null || (section.stateFlags()[gpurBlockIndex(x, y, z)] & GPUR_SOLID_FLAG) == 0 ? 1 : 0);
+    }
+
+    private byte gpurTransparentByte(GpurPreparedSection preparedSection, int x, int y, int z, LevelChunkSection fallbackSection) {
+        return preparedSection != null ? this.gpurTransparentByte(preparedSection, x, y, z) : this.gpurTransparentByte(fallbackSection, x, y, z);
+    }
+
+    private byte gpurTransparentByte(LevelChunkSection chunkSection, int x, int y, int z) {
+        return (byte)(chunkSection == EMPTY_SECTION || isTransparent(chunkSection, x, y, z) ? 1 : 0);
+    }
+
+    private static int gpurBlockIndex(int x, int y, int z) {
+        return (y << 8) | (z << 4) | x;
+    }
+
+    private static int gpurPaddedIndex(int x, int y, int z) {
+        return y * GPUR_PADDED_SLICE + z * GPUR_PADDED_EDGE + x;
+    }
